# Mailu configuration. Copy to mailu.env (git-ignored) and fill in the two secrets:
#   sed -i "s/^SECRET_KEY=.*/SECRET_KEY=$(openssl rand -hex 16)/; s/^API_TOKEN=.*/API_TOKEN=$(openssl rand -hex 32)/" mailu.env
# Reference: https://mailu.io/2024.06/configuration.html

SECRET_KEY=
API_TOKEN=

# --- Domain and hostnames
DOMAIN=alcomconsultants.co.ke
HOSTNAMES=mail.alcomconsultants.co.ke
POSTMASTER=admin
SITENAME=Alcom Consultants Mail
WEBSITE=https://alcomconsultants.co.ke
SUBNET=192.168.203.0/24

# --- TLS: mail ports use the edge's Let's Encrypt certificate (paths relative to /certs);
# the web UI is plain HTTP behind the edge Nginx, which terminates HTTPS.
TLS_FLAVOR=mail
TLS_CERT_FILENAME=live/mail.alcomconsultants.co.ke/fullchain.pem
TLS_KEYPAIR_FILENAME=live/mail.alcomconsultants.co.ke/privkey.pem
# Trust X-Real-IP only from the edge proxy network (so rate limits see real client IPs).
REAL_IP_HEADER=X-Real-IP
REAL_IP_FROM=172.18.0.0/16

# --- Features
ADMIN=true
WEBMAIL=roundcube
API=false
WEBDAV=none
ANTIVIRUS=clamav
SCAN_MACROS=true
FETCHMAIL_ENABLED=False
WEBROOT_REDIRECT=/webmail
WEB_ADMIN=/admin
WEB_WEBMAIL=/webmail
WEB_API=/api

# --- Limits and security
AUTH_RATELIMIT_IP=60/hour
AUTH_RATELIMIT_USER=100/day
# Outgoing messages per user per day (the website's noreply@ sends notifications).
MESSAGE_RATELIMIT=500/day
MESSAGE_SIZE_LIMIT=50000000
RELAYNETS=
RELAYHOST=
REJECT_UNLISTED_RECIPIENT=yes
CREDENTIAL_ROUNDS=12
DEFAULT_SPAM_THRESHOLD=80

# --- Mail settings
RECIPIENT_DELIMITER=+
DMARC_RUA=admin
DMARC_RUF=admin
WELCOME=false
COMPRESSION=zstd
COMPRESSION_LEVEL=6
FULL_TEXT_SEARCH=en
FULL_TEXT_SEARCH_ATTACHMENTS=False

# --- Misc
DISABLE_STATISTICS=True
LOG_LEVEL=WARNING
TZ=Africa/Nairobi
