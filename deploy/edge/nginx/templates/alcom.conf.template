# Rendered by the nginx image at start-up: ${DOMAIN}, ${APP_STACK} and ${ADMIN_PATH} come from
# deploy/edge/.env. Nginx's own $variables are left untouched.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

limit_req_zone $binary_remote_addr zone=api:10m rate=10r/s;
limit_req_status 429;

server_tokens off;

# ---------------------------------------------------------------- HTTP: ACME challenges + redirect
server {
    listen 80;
    server_name ${DOMAIN} www.${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://${DOMAIN}$request_uri;
    }
}

# ---------------------------------------------------------------- HTTPS: www -> apex
server {
    listen 443 ssl;
    http2 on;
    server_name www.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    include /etc/nginx/snippets/ssl.conf;

    return 301 https://${DOMAIN}$request_uri;
}

# ---------------------------------------------------------------- HTTPS: the site
server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    include /etc/nginx/snippets/ssl.conf;
    include /etc/nginx/snippets/security-headers.conf;

    client_max_body_size 25m;
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Resolve app containers through Docker DNS at request time, so a restarted
    # container (new IP) never causes 502s and Nginx can start before the app.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $frontend http://${APP_STACK}-frontend:3000;
    set $backend  http://${APP_STACK}-backend:8000;

    location /api/ {
        limit_req zone=api burst=40 nodelay;
        include /etc/nginx/proxy.conf;
        proxy_pass $backend;
    }

    location /${ADMIN_PATH} {
        include /etc/nginx/proxy.conf;
        proxy_pass $backend;
    }

    # Django static files (admin, API docs), copied into a shared volume by the backend.
    location /static/ {
        alias /srv/app/static/;
        expires 30d;
        access_log off;
    }

    location / {
        include /etc/nginx/proxy.conf;
        proxy_pass $frontend;
    }
}
