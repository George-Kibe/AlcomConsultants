# Webmail and mail admin (Mailu, deploy/mail) at mail.${DOMAIN}.
# The certificate path uses $ssl_server_name, so it is read per TLS handshake: the edge
# still starts before mail.${DOMAIN} has a certificate (see docs/MAIL.md, first start).

server {
    listen 80;
    server_name mail.${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://mail.${DOMAIN}$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name mail.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/$ssl_server_name/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/$ssl_server_name/privkey.pem;
    include /etc/nginx/snippets/ssl.conf;
    include /etc/nginx/snippets/security-headers.conf;

    client_max_body_size 50m; # webmail attachments (Mailu MESSAGE_SIZE_LIMIT)

    resolver 127.0.0.11 valid=10s ipv6=off;
    set $mailu http://mailu-front:80;

    location / {
        include /etc/nginx/proxy.conf;
        proxy_pass $mailu;
    }
}
