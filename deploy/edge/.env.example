# Edge proxy settings. On the server:  cp .env.example .env && nano .env
DOMAIN=alcomconsultants.co.ke
# REQUIRED: expiry notices go here
LETSENCRYPT_EMAIL=
# must match COMPOSE_PROJECT_NAME of the app stack
APP_STACK=alcom-prod
# REQUIRED: same value as DJANGO_ADMIN_URL, e.g. manage-7f3k9q/
ADMIN_PATH=
