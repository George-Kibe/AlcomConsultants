# Production settings for the app stack. On the server:
#   cp deploy/.env.production.example .env && nano .env
# Generate secrets with:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"

# ---------------------------------------------------------------- Stack identity
COMPOSE_PROJECT_NAME=alcom-prod
DEPLOY_ENV=prod
IMAGE_REGISTRY=ghcr.io/george-kibe
# written by deploy/deploy.sh (git commit)
APP_VERSION=

# ---------------------------------------------------------------- Site
SITE_URL=https://alcomconsultants.co.ke
# `production` lets search engines index the site. Keep `staging` until real content
# (contact details, listings) replaces the placeholders — robots.txt then blocks indexing.
SITE_ENV=staging

# ---------------------------------------------------------------- Postgres
POSTGRES_DB=alcom
POSTGRES_USER=alcom
# REQUIRED: long random value
POSTGRES_PASSWORD=

# ---------------------------------------------------------------- Django
# REQUIRED: long random value
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=alcomconsultants.co.ke,www.alcomconsultants.co.ke,localhost,backend
DJANGO_CSRF_TRUSTED_ORIGINS=https://alcomconsultants.co.ke,https://www.alcomconsultants.co.ke
# REQUIRED: secret path ending in "/", e.g. manage-7f3k9q/
DJANGO_ADMIN_URL=
# comma-separated emails for error reports (optional)
DJANGO_ADMINS=
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO
GUNICORN_WORKERS=3

# ---------------------------------------------------------------- Media (Cloudinary)
# Dashboard → API Keys → "API environment variable": cloudinary://<key>:<secret>@<cloud_name>
CLOUDINARY_URL=
CLOUDINARY_FOLDER=alcom/prod

# ---------------------------------------------------------------- Email (our Mailu server, docs/MAIL.md)
EMAIL_HOST=mail.alcomconsultants.co.ke
EMAIL_PORT=465
EMAIL_USE_TLS=false
EMAIL_USE_SSL=true
EMAIL_HOST_USER=noreply@alcomconsultants.co.ke
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Alcom Consultants <noreply@alcomconsultants.co.ke>

# ---------------------------------------------------------------- Google sign-in (blog readers, docs/AUTH.md)
# Leave empty to hide "Continue with Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------- Error tracking (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
