# Copy to `.env` for local development:  cp .env.example .env
# Production/staging values live only on the server (never commit real secrets).

# ---------------------------------------------------------------- Postgres
POSTGRES_DB=alcom
POSTGRES_USER=alcom
POSTGRES_PASSWORD=change-me

# ---------------------------------------------------------------- Django
DJANGO_SECRET_KEY=change-me-generate-with-python-secrets-token-urlsafe-50
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
DJANGO_ADMIN_URL=django-admin/
DJANGO_ADMINS=
DATABASE_URL=postgis://alcom:change-me@db:5432/alcom
REDIS_URL=redis://redis:6379/0
SITE_URL=http://localhost:8080
LOG_LEVEL=INFO

# ---------------------------------------------------------------- Email
# Development default: Mailpit (http://localhost:8025). For Gmail SMTP testing use:
#   EMAIL_HOST=smtp.gmail.com  EMAIL_PORT=587  EMAIL_USE_TLS=true
#   EMAIL_HOST_USER=you@gmail.com  EMAIL_HOST_PASSWORD=<gmail app password>
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Alcom Consultants <no-reply@alcomconsultants.co.ke>

# ---------------------------------------------------------------- Observability (production)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ---------------------------------------------------------------- Deployment (server only)
# COMPOSE_PROJECT_NAME=alcom-prod      # or alcom-staging
# DEPLOY_ENV=prod                      # or staging
# APP_VERSION=<git sha>
# GHCR_OWNER=george-kibe
