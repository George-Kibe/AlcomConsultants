# Local development: `make setup` copies this to `.env` and generates the secrets.
# DATABASE_URL is assembled by compose.yaml from the POSTGRES_* values below.
# Production/staging values live only on the server (never commit real secrets).

# ---------------------------------------------------------------- Postgres
POSTGRES_DB=alcom
POSTGRES_USER=alcom
POSTGRES_PASSWORD=            # generated by `make setup`

# ---------------------------------------------------------------- Django
DJANGO_SECRET_KEY=            # generated by `make setup`
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
DJANGO_ADMIN_URL=django-admin/
DJANGO_ADMINS=
REDIS_URL=redis://redis:6379/0
SITE_URL=http://localhost:8080
LOG_LEVEL=INFO

# ---------------------------------------------------------------- Media (Cloudinary)
# Dashboard → API Keys → "API environment variable": cloudinary://<key>:<secret>@<cloud_name>
CLOUDINARY_URL=
CLOUDINARY_FOLDER=alcom/dev

# ---------------------------------------------------------------- Email
# Development: Gmail SMTP. EMAIL_HOST_PASSWORD must be a Google *app password*
# (Google Account → Security → 2-Step Verification → App passwords), not your login password.
# While EMAIL_HOST_USER is empty, development prints emails to the backend logs instead.
# Production: our Mailu server (docs/MAIL.md): mail.alcomconsultants.co.ke, port 465, EMAIL_USE_SSL=true.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Alcom Consultants <noreply@alcomconsultants.co.ke>

# ---------------------------------------------------------------- Google sign-in (blog readers, docs/AUTH.md)
# Leave empty to hide "Continue with Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------- Observability (production)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ---------------------------------------------------------------- Deployment (server only)
# COMPOSE_PROJECT_NAME=alcom-prod      # or alcom-staging
# DEPLOY_ENV=prod                      # or staging
# APP_VERSION=<git sha>
# IMAGE_REGISTRY=ghcr.io/george-kibe

# ---------------------------------------------------------------- Enquiries (docs/ENQUIRIES.md)
# New enquiries are emailed to these addresses (comma-separated).
ENQUIRY_NOTIFY_EMAILS=info@alcomconsultants.co.ke
# Cloudflare Turnstile spam protection. Leave empty to rely on the built-in checks only.
# Cloudflare's always-pass test keys for local trials:
#   site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
